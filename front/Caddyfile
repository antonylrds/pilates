{$DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}

	# Assets com hash no nome: cache longo e 404 real quando não existem (sem cair no index.html).
	handle /assets/* {
		root * /srv
		@hit file {path}
		header @hit Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		# SPA: rotas do React Router caem no index.html.
		try_files {path} /index.html
		file_server
	}
}
