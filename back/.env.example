# Copie para .env e ajuste.

# Banco central (cadastro de estúdios)
CENTRAL_DATABASE_URL=sqlite:///./data/central.db
# Banco de cada estúdio ({slug} = identificador do estúdio, hífens viram _)
TENANT_DATABASE_URL_TEMPLATE=sqlite:///./data/tenants/{slug}.db
# Produção (uv sync --extra postgres):
# CENTRAL_DATABASE_URL=postgresql+psycopg://pilates:senha@localhost:5432/pilates_central
# TENANT_DATABASE_URL_TEMPLATE=postgresql+psycopg://pilates:senha@localhost:5432/pilates_{slug}

# Gere com: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8081"]

# Usuário da plataforma (cria estúdios) — criado por: uv run python -m app.cli init
PLATFORM_ADMIN_NAME=Plataforma
PLATFORM_ADMIN_EMAIL=root@pilates.app
PLATFORM_ADMIN_PASSWORD=root12345
